
log4rpg.debug=off, printer

log4rpg.rootLogger=DEBUG, file
log4rpg.logger.de.tools400=INFO

log4rpg.appender.file=DailyRollingFileAppender
log4rpg.appender.file.path=log4_x1p8.txt
log4rpg.appender.file.layout=SimpleLayout

// Enforce a new file every day!
log4rpg.appender.file.datePattern=_yyyy-MM-dd.






